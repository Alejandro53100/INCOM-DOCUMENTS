# Cadena de conexion de Postgres (Neon.tech u otro). Debe incluir sslmode=require en Neon.
DATABASE_URL=postgres://usuario:password@host/basededatos?sslmode=require

# Secreto para firmar la cookie de sesion del panel admin (usa un valor largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Cuenta admin inicial (se crea sola la primera vez que arranca el servidor si no existe)
ADMIN_EMAIL=admin@incom.edu.mx
ADMIN_PASSWORD_INICIAL=cambia-esta-contrasena

# API de Mailjet para enviar los correos con el enlace de firma y las notificaciones
# (SMTP directo se cuelga en el hosting actual: bloquea el protocolo SMTP saliente)
MAILJET_API_KEY=api-key-de-mailjet
MAILJET_API_SECRET=secret-key-de-mailjet
MAIL_FROM=remitente-verificado@correo.com

# URL publica donde queda desplegado el sitio (se usa para armar los enlaces de firma en los correos)
BASE_URL=http://localhost:3000

# Puerto local
PORT=3000
