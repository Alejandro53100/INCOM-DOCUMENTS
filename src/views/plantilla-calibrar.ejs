<% var title = 'Calibrar ' + plantilla.nombre + ' · INCOM Documentos'; %>
<%- include('partials/header', { title, adminEmail }) %>

<div class="card">
  <h1>Calibrar: <%= plantilla.nombre %></h1>
  <p>
    1) Elige un campo de la lista "Todos los campos". 2) Haz clic en el PDF sobre la línea donde debe imprimirse ese dato. Repite con cada campo que use este documento (no es obligatorio usarlos todos); los que ya ubicaste se marcan con ✓.
    Si un documento repite el mismo dato dos veces (ej. las dos copias del Consentimiento de Reglamento), puedes hacer clic más de una vez con el mismo campo seleccionado para colocarlo en ambos lugares.
    Si una etiqueta quedó un poco desviada, arrástrala directamente sobre el PDF para ajustar su posición; solo bórrala con la ✕ en "Campos mapeados" si ya no la necesitas.
    Para la firma, activa "Marcar zona de firma" y dibuja un rectángulo arrastrando sobre el PDF (para el Consentimiento de Reglamento, marca las dos zonas, una por cada copia).
  </p>
  <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px; flex-wrap:wrap">
    <button type="button" class="btn secundario" id="btn-pagina-prev">‹ Página anterior</button>
    <span id="indicador-pagina">Página 1</span>
    <button type="button" class="btn secundario" id="btn-pagina-next">Página siguiente ›</button>
    <button type="button" class="btn secundario" id="btn-modo-firma">Marcar zona de firma</button>
    <button type="button" class="btn" id="btn-guardar">Guardar calibración</button>
    <span id="estado-guardado"></span>
  </div>

  <div style="display:flex; gap:20px; align-items:flex-start; flex-wrap:wrap">
    <div style="position:relative; border:1px solid var(--borde)">
      <canvas id="pdf-canvas"></canvas>
      <div id="overlay" style="position:absolute; left:0; top:0; right:0; bottom:0;"></div>
    </div>

    <div class="calibrar-columnas">
      <div class="calibrar-columna">
        <h2>Todos los campos</h2>
        <p class="calibrar-ayuda">Elige uno y haz clic en el PDF. Los ya ubicados se marcan con ✓.</p>
        <% var gruposCal = {}; CAMPOS.forEach(c => { (gruposCal[c.grupo] = gruposCal[c.grupo] || []).push(c); }); %>
        <div id="lista-campos" class="lista-campos">
          <% Object.keys(gruposCal).forEach(g => { %>
            <div style="padding:4px 10px; font-size:.75rem; font-weight:700; background:#eef1f4; color:#556"><%= g %></div>
            <% gruposCal[g].forEach(c => { %>
              <div class="fila-campo" data-clave="<%= c.clave %>" data-etiqueta="<%= c.etiqueta %>">
                <span><%= c.etiqueta %></span>
                <span class="badge-usado"></span>
              </div>
            <% }) %>
          <% }) %>
        </div>
      </div>

      <div class="calibrar-columna">
        <h2>Campos mapeados</h2>
        <p class="calibrar-ayuda">Arrastra la etiqueta azul sobre el PDF para ajustar su posición.</p>
        <table id="tabla-ubicados">
          <thead><tr><th>Campo</th><th>Pág</th><th>Tam.</th><th></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
  window.PLANTILLA = {
    id: <%- JSON.stringify(plantilla.id) %>,
    pdfUrl: <%- JSON.stringify('/plantillas-pdf/' + plantilla.archivo_pdf) %>,
    mapaCampos: <%- JSON.stringify(plantilla.mapa_campos || []) %>,
    zonasFirma: <%- JSON.stringify(plantilla.zonas_firma || []) %>,
  };
</script>
<script src="/js/calibrar-cliente.js"></script>

<%- include('partials/footer') %>
